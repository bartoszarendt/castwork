{
  "id": "opencode",
  "label": "OpenCode",
  "role_frontmatter": { "model": "model", "variant": "variant" },
  "delegated_role_frontmatter": { "mode": "all", "permission": { "skill": { "castwork": "deny" } } },
  "skill_frontmatter": { "disable-model-invocation": true },
  "files": [
    { "kind": "role", "to": ".opencode/agents/{role}.md", "format": "markdown" },
    { "kind": "command", "to": ".opencode/commands/castwork.md", "format": "command" },
    { "kind": "skill", "to": ".opencode/skills/castwork/references/{skill}.md", "format": "reference" },
    { "kind": "index", "to": ".opencode/skills/castwork/SKILL.md", "format": "skill" }
  ]
}
