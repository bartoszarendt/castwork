{
  "name": "castwork",
  "version": "0.7.1",
  "description": "A small, portable vocabulary for agent work: Markdown task records carrying work, candidates, evidence, and assessments, with reusable roles, skills, host adapters, and pure checks",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.8.2",
  "bin": {
    "castwork": "./bin/castwork.js"
  },
  "exports": {
    ".": "./src/cli-main.js",
    "./record": "./src/record.js",
    "./checks": "./src/checks.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartoszarendt/castwork.git"
  },
  "homepage": "https://github.com/bartoszarendt/castwork#readme",
  "bugs": {
    "url": "https://github.com/bartoszarendt/castwork/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agentic",
    "workflow",
    "markdown",
    "opencode",
    "codex",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "files": [
    "bin/",
    "src/*.js",
    "src/adapters/",
    ".claude-plugin/",
    "CASTWORK.md",
    "agents/",
    "skills/",
    "commands/",
    "memory/",
    "config.json",
    "docs/background.md",
    "docs/record-format.md",
    "docs/examples/",
    "docs/cli.md",
    "docs/getting-started.md",
    "docs/downstream-adoption.md",
    "docs/host-adapters.md",
    "docs/skill-anatomy.md",
    "docs/codex-setup.md",
    "docs/claude-setup.md",
    "docs/opencode-setup.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
